{
	"name": "wp-cmls-base",
	"description": "Base wordpress theme for CMLS sites",
	"main": "index.js",
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format:js": "wp-scripts format-js",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:md:js": "wp-scripts lint-md-js",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"full-upgrade": "npm update && npm run packages-update && npm upgrade; pushd ./.php-cs-fixer && ./refresh.sh && popd; composer update && composer upgrade && ./rescope.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cumulus-digital/wp-cmls-base"
	},
	"keywords": [
		"wordpress",
		"cmls"
	],
	"author": "vena",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/cumulus-digital/wp-cmls-base/issues"
	},
	"homepage": "https://github.com/cumulus-digital/wp-cmls-base#readme",
	"devDependencies": {
		"@wordpress/scripts": "^36.1.0",
		"bourbon": "^7.3.0",
		"classlist-polyfill": "^1.2.0",
		"clean-webpack-plugin": "^4.0.0",
		"colord": "^2.10.0",
		"hamburgers": "^1.2.1",
		"jquery": "^4.0.0",
		"lodash": "^4.18.1",
		"prettier": "npm:wp-prettier@^3.9.6",
		"sass": "~1.83.4"
	},
	"dependencies": {
		"sass": "^1.83.4"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"unrs-resolver@1.12.2": true,
		"@parcel/watcher@2.6.0": true,
		"core-js@3.50.0": true,
		"core-js-pure@3.50.0": true
	}
}
